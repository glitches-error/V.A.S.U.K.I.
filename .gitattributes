# Normalise line endings: store LF in the repository, check out per platform.
* text=auto eol=lf

# Windows scripts must have CRLF, or cmd.exe misreads labels and some commands.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source and docs (explicit, so they always diff as text)
*.py   text diff=python
*.html text diff=html
*.css  text diff=css
*.js   text
*.json text
*.md   text diff=markdown
*.txt  text

# Binary files: never touch line endings, never diff as text
*.db     binary
*.sqlite binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
